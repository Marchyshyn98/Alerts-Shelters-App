{
  "name": "alerts-shelters",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @alerts-shelters/db generate",
    "db:migrate": "pnpm --filter @alerts-shelters/db migrate",
    "import:shelters": "pnpm --filter @alerts-shelters/worker import:shelters",
    "geocode:shelters": "pnpm --filter @alerts-shelters/worker geocode:shelters"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
