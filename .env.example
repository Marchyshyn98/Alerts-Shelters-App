# Postgres + PostGIS
POSTGRES_USER=alerts
POSTGRES_PASSWORD=alerts
POSTGRES_HOST=localhost
POSTGRES_DB=alerts_shelters
POSTGRES_DATABASE_URL=postgres://alerts:alerts@localhost:5432/alerts_shelters

# API
API_PORT=4000
# один origin або кілька через кому, без пробілів
CORS_ORIGIN=http://localhost:3000

# Worker: токен https://alerts.in.ua (запит через devs.alerts.in.ua)
ALERTS_API_TOKEN=
POLL_INTERVAL_MS=30000

# Web
NEXT_PUBLIC_API_URL=http://localhost:4000
